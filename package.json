{
  "name": "ai-research",
  "version": "2.6.0",
  "description": "AI Research desktop workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "nl.flynn.airesearch",
    "productName": "AI Research",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "AI-Research-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "flynndavies234-hub",
        "repo": "Research-Hub",
        "releaseType": "release"
      }
    ]
  }
}
